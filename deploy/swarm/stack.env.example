# SPDX-License-Identifier: AGPL-3.0-only
# Plain KEY=VALUE (optional matching quotes), no shell expansion. Defaults and code defaults below.
# Passwords/keys belong in host source files or process ENV, never in Git.
# Listen host; code default 127.0.0.1, container default 0.0.0.0.
FORM_HTTP_HOST=0.0.0.0
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_HTTP_HOST_FILE=
# trace/debug/info/notice/warning/error/critical; code default info.
# FORM_LOG_LEVEL=info
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
# FORM_LOG_LEVEL_FILE=
# Existing external DB host; code default 127.0.0.1; must match TLS certificate.
FORM_DB_HOST=mariadb.example.org
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_DB_HOST_FILE=
# Existing external DB TCP port; code default 3306.
FORM_DB_PORT=3306
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_DB_PORT_FILE=
# Existing database user; code default form; setup never creates users.
FORM_DB_USER=form
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_DB_USER_FILE=
# Existing database name; code default form; setup never creates databases.
FORM_DB_NAME=form
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_DB_NAME_FILE=
# verify (certificate + hostname) or disable; code default verify.
FORM_DB_TLS=verify
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_DB_TLS_FILE=
# Only exactly 1 permits DB TLS disable AND insecure mail/deploy targets; code default off.
FORM_ALLOW_INSECURE_DEV=0
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_ALLOW_INSECURE_DEV_FILE=
# Schema shipped with image; code default db/schema-p3.sql relative to working directory.
FORM_SCHEMA_FILE=/app/db/schema-p3.sql
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_SCHEMA_FILE_FILE=
# PWA directory in image; code default unset (API only); empty disables static PWA.
FORM_PUBLIC_DIR=/app/public
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_PUBLIC_DIR_FILE=
# Comma-separated trusted proxy CIDRs; code default empty, never trust forwarded client IPs.
FORM_TRUSTED_PROXIES=
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_TRUSTED_PROXIES_FILE=
# Comma-separated private mail/SDK deployment target CIDRs; code default empty (public only).
# FORM_MAIL_ALLOWED_NETS=
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
# FORM_MAIL_ALLOWED_NETS_FILE=
# Exact public HTTPS origin including optional port, no trailing slash; code default unset.
FORM_ADMIN_ORIGIN=https://admin.example.org
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_ADMIN_ORIGIN_FILE=
# Lowercase passkey RP host; code default unset; do not change for existing passkeys.
FORM_RP_ID=admin.example.org
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
FORM_RP_ID_FILE=
# SDK bundle directory; main.swift default /app/sdk.
# FORM_SDK_DIR=/app/sdk
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
# FORM_SDK_DIR_FILE=
# Vapor logger bootstrap variable, mentioned in main.swift; empty uses framework default. FORM_LOG_LEVEL controls app logger.
LOG_LEVEL=
# Wrapper extension: optional mounted file overrides the scalar above; default unset.
LOG_LEVEL_FILE=
# Native secret path; code default unset. Nonempty direct password wins in AppConfig, wrapper rejects both.
FORM_DB_PASSWORD_FILE=/run/secrets/db_password
# Native server-key path; 64 hex characters, owner app UID, mode 0400/0600. Code default unset.
FORM_SERVER_KEY_FILE=/run/secrets/server_key
# Native bootstrap path; main.swift default unset => generate once. Wrapper ignores optional-secret marker.
FORM_BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap_password
# Secret ENV alternatives accepted by setup; never saved to stack.env/.env (defaults unset).
# FORM_DB_PASSWORD=
# FORM_SERVER_KEY=
# FORM_BOOTSTRAP_PASSWORD=
# Host source files; empty uses <deploy-variant>/secrets/<kind>. DB password is asked, never generated.
DB_PASSWORD_SOURCE_FILE=
SERVER_KEY_SOURCE_FILE=
BOOTSTRAP_PASSWORD_SOURCE_FILE=
# Host source files or secret ENV apply only to NEW secrets; rotation requires a new secret name.
DB_PASSWORD_SECRET=
SERVER_KEY_SECRET=
BOOTSTRAP_PASSWORD_SECRET=
# Secret metadata; Compose file mounts use actual host UID/mode (setup requires rootful Linux/root).
APP_UID=10001
APP_GID=10001
# Image reference: FORM_IMAGE overrides repository/tag; successful deployment saves immutable digest here.
FORM_IMAGE=
FORM_IMAGE_REPOSITORY=ghcr.io/magicalwig34653/form-backend
FORM_IMAGE_TAG=latest
# Runtime binary and injected config paths. Wrapper should later be COPY'd into the image on main.
FORM_APP_BINARY=/app/App
ENTRYPOINT_PATH=/opt/form/docker-entrypoint.sh
HEALTHCHECK_PATH=/opt/form/healthcheck.sh
# Project/stack name, default form. Network is external to stack and created by setup if absent.
STACK=form
NETWORK_NAME=
# App limits/reservations; migration limits are independent.
APP_CPUS=1.0
APP_MEMORY=512M
APP_RESERVE_CPUS=0.25
APP_RESERVE_MEMORY=128M
MIGRATION_CPUS=1.0
MIGRATION_MEMORY=512M
# Rolling-update/rollback policy (Compose recreates a single app; no rolling-update guarantee).
UPDATE_PARALLELISM=1
UPDATE_ORDER=start-first
UPDATE_MONITOR=60s
UPDATE_DELAY=10s
UPDATE_FAILURE_ACTION=rollback
ROLLBACK_PARALLELISM=1
ROLLBACK_ORDER=start-first
ROLLBACK_MONITOR=60s
RESTART_CONDITION=any
RESTART_DELAY=5s
# Container health timing and external readiness URL (empty derives FORM_ADMIN_ORIGIN/ready).
HEALTH_INTERVAL=10s
HEALTH_TIMEOUT=5s
HEALTH_RETRIES=3
HEALTH_START_PERIOD=30s
HEALTHCHECK_URL=
WAIT_SECONDS=600
# One-shot external DB client, NOT a database server. Image includes mariadb client and dump.
DB_CLIENT_IMAGE=mariadb:12.3
# 1 = vor der Migration zusätzlich den DB-Zugang mit dem MariaDB-Client-Image prüfen (zieht dieses Image); 0 = nur Migrationslauf.
DB_PRECHECK=0
# Backup/Restore client backend: docker or local (installed mariadb and mariadb-dump).
DB_CLIENT_MODE=docker
# Backup/Compose client network; empty derives NETWORK_NAME (or default Docker network for standalone backups).
DB_CLIENT_NETWORK=
# CA mount path inside one-shot clients; does not change application trust.
DB_CLIENT_CA_PATH=/run/form-db-ca
DB_CLIENT_MEMORY=256m
DB_CONNECT_TIMEOUT=10
# Client-only optional CA bundle on host; application uses image system trust, no native CA env exists.
DB_TLS_CA_FILE=
# Swarm cannot bind published ports to one host IP; retained all-interface setting.
BIND_ADDR=0.0.0.0
# Publication mode for each enabled port: ingress (routing mesh) or host (task node).
PUBLISH_MODE=ingress
# Host port of the dashboard (internal listener, container 8081); empty = overlay alias only, no publication.
FORM_PUBLISH_PORT=8081
# Optional app-pinned host port; must differ from FORM_PUBLISH_PORT.
# Not published while FORM_PINNED_NODE is empty.
FORM_PINNED_PUBLISH_PORT=
# Swarm has no per-IP bind for published service ports; empty or 0.0.0.0 only.
# Restrict access to the external proxy with the host/network firewall.
FORM_PUBLISH_BIND=
# Main service replicas; total = FORM_REPLICAS + active FORM_PINNED_REPLICAS.
FORM_REPLICAS=3
# Comma-separated hard constraints for app only; empty = no custom constraints.
FORM_PLACEMENT_CONSTRAINTS=
# Comma-separated soft spread preferences for app, e.g. spread=node.labels.zone.
FORM_PLACEMENT_PREFERENCES=
# Exact hostname or full 25-character Swarm Node-ID; empty disables app-pinned.
FORM_PINNED_NODE=
# Additional replicas on the pinned node; positive integer, default 1.
FORM_PINNED_REPLICAS=1
# Optional node-label key, e.g. reserved => node.labels.reserved!=true.
# Applies to app, DB check and migration; app-pinned is exempt.
FORM_EXCLUDE_LABEL=
NETWORK_DRIVER=overlay

# Container ports: public listener (SDK/ingest) and internal listener (dashboard/admin API).
FORM_PUBLIC_PORT=8080
# FORM_PUBLIC_PORT_FILE= # Nicht unterstützt: Ports nur direkt setzen.
FORM_INTERNAL_PORT=8081
# FORM_INTERNAL_PORT_FILE= # Nicht unterstützt: Ports nur direkt setzen.
FORM_INTERNAL_SECOND_FACTOR=0
FORM_INTERNAL_SECOND_FACTOR_FILE=
FORM_PUBLIC_DASHBOARD=0
FORM_PUBLIC_DASHBOARD_FILE=
FORM_PUBLIC_DASHBOARD_HOSTS=
FORM_PUBLIC_DASHBOARD_HOSTS_FILE=
# FORM_PUBLIC_TRUSTED_PROXIES=
# FORM_PUBLIC_TRUSTED_PROXIES_FILE=
# FORM_INTERNAL_TRUSTED_PROXIES=
# FORM_INTERNAL_TRUSTED_PROXIES_FILE=

# Optional public listener publication; host port of the public listener (container port FORM_PUBLIC_PORT).
FORM_PUBLIC_PUBLISH_PORT=8080
FORM_PINNED_PUBLIC_PUBLISH_PORT=

# Systemeinstellungen: auskommentiert = ENV fehlt, DB > Default; gesetzt (auch leer) = gesperrt.
# ops.threshold (integer); Standard 1.
# FORM_OPS_THRESHOLD=1
# FORM_OPS_THRESHOLD_FILE=
# ops.intervalSeconds (integer); Standard 900.
# FORM_OPS_INTERVAL_SECONDS=900
# FORM_OPS_INTERVAL_SECONDS_FILE=
# ops.retentionDays (integer); Standard 30.
# FORM_OPS_RETENTION_DAYS=30
# FORM_OPS_RETENTION_DAYS_FILE=
# ops.recipient (mailbox); Standard leer.
# FORM_OPS_RECIPIENT=
# FORM_OPS_RECIPIENT_FILE=
# ops.sender (mailbox); Standard leer.
# FORM_OPS_SENDER=
# FORM_OPS_SENDER_FILE=
# ops.connection (uuid); Standard leer.
# FORM_OPS_CONNECTION=
# FORM_OPS_CONNECTION_FILE=
# abuse.blockedNets (cidrs); Standard leer.
# FORM_ABUSE_BLOCKED_NETS=
# FORM_ABUSE_BLOCKED_NETS_FILE=
# abuse.uaPatterns (patterns); Standard [].
# FORM_ABUSE_UA_PATTERNS=[]
# FORM_ABUSE_UA_PATTERNS_FILE=
# abuse.hashes (hashes); Standard [].
# FORM_ABUSE_HASHES=[]
# FORM_ABUSE_HASHES_FILE=
# abuse.threshold (integer); Standard 5.
# FORM_ABUSE_THRESHOLD=5
# FORM_ABUSE_THRESHOLD_FILE=
# abuse.windowSeconds (integer); Standard 600.
# FORM_ABUSE_WINDOW_SECONDS=600
# FORM_ABUSE_WINDOW_SECONDS_FILE=
# abuse.banSeconds (integer); Standard 7200.
# FORM_ABUSE_BAN_SECONDS=7200
# FORM_ABUSE_BAN_SECONDS_FILE=
# mail.restricted (boolean); Standard false.
# FORM_MAIL_RESTRICTED=false
# FORM_MAIL_RESTRICTED_FILE=
# mail.allowedRecipients (recipients); Standard [].
# FORM_MAIL_ALLOWED_RECIPIENTS=[]
# FORM_MAIL_ALLOWED_RECIPIENTS_FILE=
# migration.allowedNets (cidrs); Standard leer.
# FORM_MIGRATION_ALLOWED_NETS=
# FORM_MIGRATION_ALLOWED_NETS_FILE=
# webhook.perForm (integer); Standard 5.
# FORM_WEBHOOK_MAX_PER_FORM=5
# FORM_WEBHOOK_MAX_PER_FORM_FILE=
# webhook.perCustomer (integer); Standard 20.
# FORM_WEBHOOK_MAX_PER_CUSTOMER=20
# FORM_WEBHOOK_MAX_PER_CUSTOMER_FILE=
# webhook.backlog (integer); Standard 1000.
# FORM_WEBHOOK_MAX_BACKLOG_PER_CUSTOMER=1000
# FORM_WEBHOOK_MAX_BACKLOG_PER_CUSTOMER_FILE=
# Admin-API-Anfragen je Minute und Client-IP (integer 1-100000); Standard 600. Neustart nötig.
# FORM_ADMIN_REQUEST_LIMIT_IP=600
# FORM_ADMIN_REQUEST_LIMIT_IP_FILE=
# Admin-API-Anfragen je Minute und angemeldetem Konto (integer 1-100000); Standard 300. Neustart nötig.
# FORM_ADMIN_REQUEST_LIMIT_ACCOUNT=300
# FORM_ADMIN_REQUEST_LIMIT_ACCOUNT_FILE=
# mcp.requestsPerMinute (integer); Standard 60.
# FORM_MCP_TOKEN_RATE_LIMIT=60
# FORM_MCP_TOKEN_RATE_LIMIT_FILE=
# ingest.requestsPerMinute (integer); Standard 60, 0 = aus.
# FORM_INGEST_REQUESTS_PER_MINUTE=60
# FORM_INGEST_REQUESTS_PER_MINUTE_FILE=
# oauth.authorizeBaseURL (origin); Standard leer.
# FORM_OAUTH_AUTHORIZE_BASE_URL=
# FORM_OAUTH_AUTHORIZE_BASE_URL_FILE=
# oauth.registrationsPerHour (integer); Standard 200.
# FORM_OAUTH_REGISTRATIONS_PER_HOUR=200
# FORM_OAUTH_REGISTRATIONS_PER_HOUR_FILE=
# oauth.maxUnusedClients (integer); Standard 1000.
# FORM_OAUTH_MAX_UNUSED_CLIENTS=1000
# FORM_OAUTH_MAX_UNUSED_CLIENTS_FILE=
# oauth.issuer (origin); Standard leer.
# FORM_OAUTH_ISSUER=
# FORM_OAUTH_ISSUER_FILE=
