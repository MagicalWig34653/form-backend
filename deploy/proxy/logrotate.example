# SPDX-License-Identifier: AGPL-3.0-only
# Proxy-Logs: Frist 7 Tage. Nach /etc/logrotate.d/form-proxy kopieren (Pfade anpassen; bei nginx
# im Container das Log-Verzeichnis als Volume auf den Host legen).
/var/log/nginx/form-access.log /var/log/nginx/form-error.log {
    daily
    rotate 7
    maxage 7
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        # nginx im Container stattdessen: docker kill -s USR1 <proxy-container>
        [ ! -f /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
