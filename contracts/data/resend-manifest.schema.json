{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/data/0.1.0/resend-manifest.schema.json",
  "title": "resend-manifest-v1 (VORGESCHLAGEN, Vertragsrunde 3 R07)",
  "description": "Klartextstruktur des verschluesselten stored_objects mit object_role=mail-manifest. Wird einmal beim Eingang erzeugt und nie veraendert. Objektbezuege nur ueber objectId + payloadSha256 (SHA-256 ueber iv||ct||tag des Nutzchiffrats, rewrap-invariant). Keine Huellenrevision, kein Paketdigest, keine Generation, keine Schluessel. SPDX-License-Identifier: AGPL-3.0-only. Vertragsrunde 4 (M3, VORGESCHLAGEN): subject/displayName/address/connectionAlias/targetRef ohne Steuerzeichen (Pattern). Nicht per Schema erzwingbar, daher Pflichtpruefung in objektinventar.md: objectId, (role,ordinal) und deliveryId eindeutig; bodyObjectId/attachmentObjectIds muessen in objects vorkommen.",
  "type": "object",
  "properties": {
    "manifestVersion": {
      "const": "resend-manifest-v1"
    },
    "submissionId": {
      "$ref": "#/$defs/uuid"
    },
    "sourceReleaseId": {
      "$ref": "#/$defs/uuid"
    },
    "sourceMode": {
      "enum": [
        "production",
        "test"
      ]
    },
    "effectSlot": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objectRef"
      }
    },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/delivery"
      }
    }
  },
  "required": [
    "manifestVersion",
    "submissionId",
    "sourceReleaseId",
    "sourceMode",
    "effectSlot",
    "createdAt",
    "objects",
    "deliveries"
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objectRef": {
      "type": "object",
      "properties": {
        "objectId": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "enum": [
            "data",
            "attachment",
            "mail-organisation",
            "mail-filler",
            "legacy-errors",
            "object-metadata"
          ]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "payloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "plaintextBytes": {
          "type": "integer",
          "minimum": 0
        },
        "contentEncoding": {
          "enum": [
            "raw",
            "legacy-json-force-object",
            "legacy-base64-trimmed-mail"
          ]
        }
      },
      "required": [
        "objectId",
        "role",
        "ordinal",
        "payloadSha256",
        "plaintextBytes",
        "contentEncoding"
      ],
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "to",
            "cc",
            "bcc",
            "reply-to"
          ]
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 320,
          "pattern": "^[^\\u0000-\\u0020\\u007F\\u2028\\u2029]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
        }
      },
      "required": [
        "kind",
        "address"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "description": "Eine stabile Zustellidentitaet. Der Mailkoerper ist ein bereits gerenderter, gespeicherter Nutzdatenstand (bodyObjectId); beim Resend wird nichts neu aus aktuellen Vorlagen gerendert.",
      "properties": {
        "deliveryId": {
          "$ref": "#/$defs/uuid"
        },
        "channel": {
          "enum": [
            "mail",
            "webhook"
          ]
        },
        "connectionAlias": {
          "type": "string",
          "maxLength": 190,
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
        },
        "templateRef": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "versionNo": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "versionNo"
          ],
          "additionalProperties": false
        },
        "subject": {
          "type": "string",
          "maxLength": 998,
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
        },
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          },
          "maxItems": 200
        },
        "bodyObjectId": {
          "$ref": "#/$defs/uuid"
        },
        "attachmentObjectIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "uniqueItems": true
        },
        "targetRef": {
          "type": "string",
          "maxLength": 190,
          "description": "Nur Alias/Zielreferenz eines Webhooks, keine URL mit Secret.",
          "pattern": "^[^\\u0000-\\u001F\\u007F\\u2028\\u2029]*$"
        }
      },
      "required": [
        "deliveryId",
        "channel",
        "bodyObjectId",
        "attachmentObjectIds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": "mail"
              }
            }
          },
          "then": {
            "required": [
              "connectionAlias",
              "recipients",
              "subject"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "channel": {
                "const": "webhook"
              }
            }
          },
          "then": {
            "required": [
              "targetRef"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
