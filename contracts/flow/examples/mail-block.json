{
  "contractVersion": "0.1.0",
  "proposalStatus": "VORGESCHLAGEN",
  "id": "synthetic-mail",
  "version": "1.0.0",
  "module": {
    "id": "synthetic-core",
    "version": "1.0.0",
    "sha256": "137a2ffaafa322f33670e0664ddaddb6e60b9bb70ea7bb5341c3b96134701b15"
  },
  "title": {
    "de": "Manueller Mailversand"
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "format": "email"
      }
    },
    "required": [
      "email"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean"
      }
    },
    "required": [
      "valid"
    ],
    "additionalProperties": false
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "locations": [
    "backend-worker"
  ],
  "permissions": [
    "flow.execute"
  ],
  "connections": [
    {
      "alias": "smtp-test",
      "kind": "smtp",
      "required": true
    }
  ],
  "plaintext": {
    "required": true,
    "allowedLocations": [
      "backend-worker"
    ],
    "persistence": "forbidden"
  },
  "limits": {
    "maxSteps": 1000,
    "activeTimeoutMs": 30000,
    "maxElapsedMs": 86400000,
    "memoryBytes": 67108864,
    "nodeTimeoutMs": 5000,
    "maxStateBytes": 1048576
  },
  "effectKind": "mail",
  "idempotency": "manual-on-uncertain",
  "retry": {
    "mode": "manual-authorized",
    "maxAttempts": 5,
    "initialDelayMs": 60000,
    "maxDelayMs": 3600000,
    "backoffFactor": 2,
    "jitter": true
  },
  "debug": {
    "valuePolicy": "masked-only",
    "sensitiveInputPointers": [
      "/email"
    ],
    "sensitiveOutputPointers": []
