{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/flow/0.1.0/package.schema.json",
  "title": "Import-/Exportpaket ohne Zugangsdaten",
  "description": "P2-4; Vertragsentwurf 0.1.0, VORGESCHLAGEN. Bestätigte Anforderungen siehe README.md.",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalStatus": {
      "const": "VORGESCHLAGEN"
    },
    "packageId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "packageRevision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "credentialPolicy": {
      "const": "references-only"
    },
    "importPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "draft-only"
        },
        "idempotency": {
          "const": "package-id-revision-digest"
        },
        "conflicts": {
          "const": "require-explicit-mapping"
        },
        "externalEffects": {
          "const": "forbidden"
        }
      },
      "required": [
        "mode",
        "idempotency",
        "conflicts",
        "externalEffects"
      ],
      "additionalProperties": false
    },
    "forms": {
      "type": "array",
      "items": {
        "$ref": "form.schema.json"
      },
      "minItems": 1
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "view.schema.json"
      },
      "minItems": 1
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "graph.schema.json"
      },
      "minItems": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "block.schema.json"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "module.schema.json"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "script-artifact.schema.json"
      }
    },
    "sandboxRequirements": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reference"
      },
      "uniqueItems": true
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "mediaType": {
            "enum": [
              "text/plain",
              "text/html"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "mediaType",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/connection"
      },
      "uniqueItems": true
    },
    "moduleRequirements": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reference"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "contractVersion",
    "proposalStatus",
    "packageId",
    "packageRevision",
    "createdAt",
    "credentialPolicy",
    "importPolicy",
    "forms",
    "views",
    "flows",
    "blocks",
    "modules",
    "scripts",
    "sandboxRequirements",
    "templates",
    "connections",
    "moduleRequirements"
  ],
  "additionalProperties": false
}
