{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/flow/0.1.0/view.schema.json",
  "title": "Ansicht",
  "description": "P2-4; Vertragsentwurf 0.1.0, VORGESCHLAGEN. Bestätigte Anforderungen siehe README.md.",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalStatus": {
      "const": "VORGESCHLAGEN"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "form": {
      "$ref": "common.schema.json#/$defs/resourceReference"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "parameters": {
          "$ref": "common.schema.json#/$defs/portableValue"
        }
      },
      "required": [
        "id",
        "version",
        "parameters"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "title": {
                  "$ref": "common.schema.json#/$defs/localized"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fieldId": {
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "labelOverride": {
                        "$ref": "common.schema.json#/$defs/localized"
                      },
                      "readOnly": {
                        "type": "boolean"
                      },
                      "disabled": {
                        "type": "boolean"
                      },
                      "showWhen": {
                        "$ref": "common.schema.json#/$defs/jsonSchema"
                      }
                    },
                    "required": [
                      "fieldId",
                      "readOnly",
                      "disabled"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "title",
                "fields"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "title",
          "sections"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contractVersion",
    "proposalStatus",
    "id",
    "version",
    "form",
    "title",
    "theme",
    "steps"
  ],
  "additionalProperties": false
}
