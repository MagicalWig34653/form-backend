{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/flow/0.1.0/debug-event.schema.json",
  "title": "Maskiertes Debugereignis",
  "description": "P2-4; Vertragsentwurf 0.1.0, VORGESCHLAGEN. Bestätigte Anforderungen siehe README.md.",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalStatus": {
      "const": "VORGESCHLAGEN"
    },
    "eventId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "form": {
      "$ref": "common.schema.json#/$defs/resourceReference"
    },
    "release": {
      "$ref": "common.schema.json#/$defs/resourceReference"
    },
    "executionId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "debugSessionId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "test",
        "observe"
      ]
    },
    "effectMode": {
      "enum": [
        "simulate",
        "test-target",
        "observe-only"
      ]
    },
    "testTargetAlias": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "occurredAt": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "recordingStartedAt": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "ttlSeconds": {
      "const": 900
    },
    "event": {
      "enum": [
        "node-started",
        "node-finished",
        "validation",
        "branch",
        "suspended",
        "resumed",
        "failed",
        "field-changed"
      ]
    },
    "nodeId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "visit": {
      "type": "integer",
      "minimum": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "running",
        "success",
        "rejected",
        "waiting",
        "failed"
      ]
    },
    "input": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "pointer": {
            "$ref": "common.schema.json#/$defs/pointer"
          },
          "display": {
            "const": "[MASKIERT]"
          },
          "reason": {
            "enum": [
              "sensitive",
              "secret",
              "profile",
              "default-deny"
            ]
          }
        },
        "required": [
          "fieldId",
          "pointer",
          "display",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "pointer": {
            "$ref": "common.schema.json#/$defs/pointer"
          },
          "display": {
            "const": "[MASKIERT]"
          },
          "reason": {
            "enum": [
              "sensitive",
              "secret",
              "profile",
              "default-deny"
            ]
          }
        },
        "required": [
          "fieldId",
          "pointer",
          "display",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "changedFieldIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "validationCodes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "recipientAliases": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "encryptionState": {
      "enum": [
        "ciphertext",
        "ephemeral-plaintext",
        "mixed"
      ]
    },
    "keyIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/kid"
      },
      "uniqueItems": true
    },
    "errorCode": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "exportPolicy": {
      "const": "masked-only"
    }
  },
  "required": [
    "contractVersion",
    "proposalStatus",
    "eventId",
    "tenantId",
    "form",
    "release",
    "executionId",
    "debugSessionId",
    "sequence",
    "mode",
    "effectMode",
    "occurredAt",
    "recordingStartedAt",
    "expiresAt",
    "ttlSeconds",
    "event",
    "nodeId",
    "visit",
    "status",
    "input",
    "output",
    "changedFieldIds",
    "validationCodes",
    "recipientAliases",
    "encryptionState",
    "keyIds",
    "exportPolicy"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "observe"
          }
        }
      },
      "then": {
        "properties": {
          "effectMode": {
            "const": "observe-only"
          }
        }
      },
      "else": {
        "properties": {
          "effectMode": {
            "enum": [
              "simulate",
              "test-target"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effectMode": {
            "const": "test-target"
          }
        }
      },
      "then": {
        "required": [
          "testTargetAlias"
        ]
      },
      "else": {
        "not": {
          "required": [
            "testTargetAlias"
          ]
        }
      }
    }
  ]
}
