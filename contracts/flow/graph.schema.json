{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/flow/0.1.0/graph.schema.json",
  "title": "Versionierter Ablaufgraph",
  "description": "P2-4; Vertragsentwurf 0.1.0, VORGESCHLAGEN. Bestätigte Anforderungen siehe README.md.",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalStatus": {
      "const": "VORGESCHLAGEN"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "engineContractVersion": {
      "const": "0.1.0"
    },
    "entryNode": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "limits": {
      "$ref": "common.schema.json#/$defs/limits"
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "entry"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              }
            },
            "required": [
              "kind",
              "label"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "end"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "result": {
                "enum": [
                  "success",
                  "rejected",
                  "failed"
                ]
              }
            },
            "required": [
              "kind",
              "label",
              "result"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "block"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "block": {
                "$ref": "common.schema.json#/$defs/reference"
              },
              "location": {
                "$ref": "common.schema.json#/$defs/location"
              },
              "config": {
                "$ref": "common.schema.json#/$defs/portableValue"
              },
              "inputBindings": {
                "type": "object",
                "propertyNames": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "sourceNode": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "pointer": {
                      "$ref": "common.schema.json#/$defs/pointer"
                    }
                  },
                  "required": [
                    "sourceNode",
                    "pointer"
                  ],
                  "additionalProperties": false
                },
                "minProperties": 0
              }
            },
            "required": [
              "kind",
              "label",
              "block",
              "location",
              "config",
              "inputBindings"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "condition"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "predicate": {
                "$ref": "common.schema.json#/$defs/jsonSchema"
              }
            },
            "required": [
              "kind",
              "label",
              "predicate"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "loop"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "maxIterations": {
                "type": "integer",
                "minimum": 1
              },
              "predicate": {
                "$ref": "common.schema.json#/$defs/jsonSchema"
              }
            },
            "required": [
              "kind",
              "label",
              "maxIterations",
              "predicate"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "wait"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "durationMs": {
                "type": "integer",
                "minimum": 1
              },
              "onTimeout": {
                "const": "fail"
              }
            },
            "required": [
              "kind",
              "label",
              "durationMs",
              "onTimeout"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "approval"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "permission": {
                "const": "flow.approve"
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1
              },
              "onTimeout": {
                "enum": [
                  "reject",
                  "fail"
                ]
              },
              "requireHuman": {
                "const": true
              }
            },
            "required": [
              "kind",
              "label",
              "permission",
              "timeoutMs",
              "onTimeout",
              "requireHuman"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "script"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "artifact": {
                "$ref": "common.schema.json#/$defs/reference"
              },
              "sandboxProfile": {
                "$ref": "common.schema.json#/$defs/reference"
              },
              "inputSchema": {
                "$ref": "common.schema.json#/$defs/jsonSchema"
              },
              "outputSchema": {
                "$ref": "common.schema.json#/$defs/jsonSchema"
              },
              "limits": {
                "$ref": "common.schema.json#/$defs/limits"
              },
              "plaintext": {
                "$ref": "common.schema.json#/$defs/plaintext"
              }
            },
            "required": [
              "kind",
              "label",
              "artifact",
              "sandboxProfile",
              "inputSchema",
              "outputSchema",
              "limits",
              "plaintext"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "subflow"
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localized"
              },
              "flow": {
                "$ref": "common.schema.json#/$defs/resourceReference"
              }
            },
            "required": [
              "kind",
              "label",
              "flow"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minProperties": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "port": {
            "enum": [
              "next",
              "true",
              "false",
              "body",
              "done",
              "resume",
              "approved",
              "rejected",
              "error"
            ]
          },
          "to": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "from",
          "port",
          "to"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "failurePolicy": {
      "const": "stop-and-record"
    }
  },
  "required": [
    "contractVersion",
    "proposalStatus",
    "id",
    "version",
    "engineContractVersion",
    "entryNode",
    "limits",
    "nodes",
    "edges",
    "failurePolicy"
  ],
  "additionalProperties": false
}
