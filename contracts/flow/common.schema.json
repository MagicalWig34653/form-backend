{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/flow/0.1.0/common.schema.json",
  "title": "Gemeinsame Typen",
  "description": "P2-4; Vertragsentwurf 0.1.0, VORGESCHLAGEN. Bestätigte Anforderungen siehe README.md.",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "location": {
      "enum": [
        "browser",
        "php-server",
        "docker-agent",
        "backend-api",
        "backend-worker",
        "unlocked-admin-browser"
      ]
    },
    "localized": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "activeTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxElapsedMs": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "nodeTimeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxStateBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxSteps",
        "activeTimeoutMs",
        "maxElapsedMs",
        "memoryBytes",
        "nodeTimeoutMs",
        "maxStateBytes"
      ],
      "additionalProperties": false,
      "description": "VORGESCHLAGEN: keine Standardwerte. Aktive Zeit und Gesamtdauer getrennt; Gesamtdauer umfasst Wartezeiten."
    },
    "plaintext": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "allowedLocations": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/location"
          },
          "uniqueItems": true
        },
        "persistence": {
          "const": "forbidden"
        }
      },
      "required": [
        "required",
        "allowedLocations",
        "persistence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "allowedLocations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "never",
            "automatic",
            "manual-authorized"
          ]
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "initialDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "maxDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "backoffFactor": {
          "type": "number",
          "minimum": 1
        },
        "jitter": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "maxAttempts",
        "initialDelayMs",
        "maxDelayMs",
        "backoffFactor",
        "jitter"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "never"
              }
            }
          },
          "then": {
            "properties": {
              "maxAttempts": {
                "const": 1
              }
            }
          }
        }
      ]
    },
    "jsonSchema": {
      "$ref": "https://json-schema.org/draft/2020-12/schema",
      "description": "Eigenständiges Draft-2020-12-Schema; Import löst nur erlaubte lokale Paketreferenzen auf."
    },
    "portableValue": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ],
      "propertyNames": {
        "not": {
          "pattern": "^([cC][rR][eE][dD][eE][nN][tT][iI][aA][lL][sS]?|[pP][aA][sS][sS][wW][oO][rR][dD]|[pP][aA][sS][sS][pP][hH][rR][aA][sS][eE]|[sS][eE][cC][rR][eE][tT]|[tT][oO][kK][eE][nN]|[pP][rR][iI][vV][aA][tT][eE].?[kK][eE][yY]|[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[cC][oO][oO][kK][iI][eE])$"
        }
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/portableValue"
      },
      "items": {
        "$ref": "common.schema.json#/$defs/portableValue"
      },
      "description": "Keine Credentials. Namensfilter ist nur zusätzliche Schranke; Inhaltskontrolle bleibt erforderlich."
    },
    "connection": {
      "type": "object",
      "properties": {
        "alias": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "kind": {
          "enum": [
            "smtp",
            "mail-proxy",
            "webhook",
            "s3",
            "sftp",
            "captcha",
            "test-target"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "alias",
        "kind",
        "required"
      ],
      "additionalProperties": false
    },
    "pointer": {
      "type": "string",
      "pattern": "^(|(/([^~/]|~[01])*)+)$"
    },
    "protectedRef": {
      "type": "object",
      "properties": {
        "objectId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "encryption": {
          "const": "KUBUS-AEAD:2"
        },
        "keyGeneration": {
          "type": "integer",
          "minimum": 1,
          "description": "Schnappschuss zum Erzeugungszeitpunkt (R07, VORGESCHLAGEN); nach Rewrap/Rotation nicht als Gleichheitsbedingung gegen die aktuelle Hülle prüfen. Aktuelle Werte stehen in stored_objects."
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "Schnappschuss des Paketdigests zum Erzeugungszeitpunkt (R07, VORGESCHLAGEN); keine dauerhafte Inhaltsidentität. Unveränderliche Nutzdatenidentität ist payloadSha256 (data/objektinventar.md)."
        }
      },
      "required": [
        "objectId",
        "encryption",
        "keyGeneration",
        "sha256"
      ],
      "additionalProperties": false
    },
    "versionReference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "VORGESCHLAGEN: Ressourcen-ID; SQL BINARY(16) in Textbyte-Reihenfolge, kein Byte-Swap."
    },
    "kid": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "resourceReference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/version"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
