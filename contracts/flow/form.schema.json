{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://form-backend.invalid/contracts/flow/0.1.0/form.schema.json",
  "title": "Formulardefinition",
  "description": "P2-4; Vertragsentwurf 0.1.0, VORGESCHLAGEN. Bestätigte Anforderungen siehe README.md.",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-only",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": "0.1.0"
    },
    "proposalStatus": {
      "const": "VORGESCHLAGEN"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "tenantId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "title": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "unknownFields": {
      "enum": [
        "reject",
        "discard"
      ]
    },
    "normalization": {
      "const": "typed-v1"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 190,
            "pattern": "^[A-Za-z0-9_.()\\[\\]-]+$",
            "not": {
              "enum": [
                "csrf_token",
                "cf-turnstile-response",
                "g-recaptcha-response",
                "h-captcha-response"
              ]
            }
          },
          "kind": {
            "enum": [
              "text",
              "email",
              "date",
              "number",
              "boolean",
              "choice",
              "file"
            ]
          },
          "label": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "required": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          },
          "validation": {
            "$ref": "common.schema.json#/$defs/jsonSchema"
          },
          "fixedValue": {
            "$ref": "common.schema.json#/$defs/portableValue"
          }
        },
        "required": [
          "name",
          "kind",
          "label",
          "required",
          "hidden",
          "locked",
          "sensitive",
          "validation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "locked": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "fixedValue"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "fixedValue"
                ]
              }
            }
          }
        ]
      },
      "minProperties": 1
    },
    "security": {
      "type": "object",
      "properties": {
        "encryptionProfile": {
          "const": "hpke-v2",
          "description": "ADR 0004: sym-v2 als Speicherprofil gesperrt; optionale Transporthülle ist separater Vertrag."
        },
        "transport": {
          "enum": [
            "off",
            "offered",
            "required"
          ],
          "default": "off",
          "description": "VORGESCHLAGEN Vertragsrunde 3 R05: Zusatzhülle pro Formular (ADR 0003 Nr. 4). off = nur reguläre Routen; offered = beide Wege zulässig; required = reguläre Routen und Legacyadapter lehnen ab. Wirksam erst mit bestätigtem Release; Details und offene Produktwahl: contracts/crypto/transport.md."
        },
        "specialCategories": {
          "type": "boolean",
          "description": "ADR 0009 F3: Art.-9-relevant data; required."
        },
        "abuse": {
          "type": "object",
          "description": "ADR 0026: veröffentlichter Missbrauchsschutz; Secrets ausschließlich im SecretStore.",
          "properties": {
            "siteKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "failPolicy": {
              "enum": [
                "open",
                "closed"
              ],
              "default": "open"
            },
            "testMode": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "encryptionProfile",
        "specialCategories"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "adapter": {
          "enum": [
            "db",
            "s3",
            "sftp"
          ]
        },
        "connectionAlias": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "maxSubmissionBytes": {
          "type": "integer",
          "minimum": 1
        },
        "onFailure": {
          "const": "reject-acceptance"
        }
      },
      "required": [
        "adapter",
        "maxSubmissionBytes",
        "onFailure"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "enum": [
                  "s3",
                  "sftp"
                ]
              }
            }
          },
          "then": {
            "required": [
              "connectionAlias"
            ]
          },
          "else": {
            "not": {
              "required": [
                "connectionAlias"
              ]
            }
          }
        }
      ]
    },
    "mail": {
      "type": "object",
      "description": "VORGESCHLAGEN (ADR 0010): mail with content, sent by the server at ingest from the in-memory submission; nothing is stored. Field names refer to the submitted names (fields[*].name).",
      "properties": {
        "from": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "maxLength": 254,
              "description": "Plain ASCII addr-spec (no display name)."
            },
            "name": {
              "type": "string",
              "maxLength": 100
            }
          },
          "required": [
            "address"
          ],
          "additionalProperties": false
        },
        "organisation": {
          "type": "object",
          "properties": {
            "to": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 254,
                "description": "Plain ASCII addr-spec (no display name)."
              },
              "maxItems": 20
            },
            "bcc": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 254,
                "description": "Plain ASCII addr-spec (no display name)."
              },
              "maxItems": 20
            },
            "replyToField": {
              "type": "string"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Placeholders #=[fieldName]=# (legacy syntax); values are stripped of line breaks."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "description": "Placeholders #=[fieldName]=#; values are HTML-escaped when format is html."
            },
            "format": {
              "enum": [
                "text",
                "html"
              ],
              "default": "text"
            }
          },
          "required": [
            "to",
            "subject",
            "body"
          ],
          "additionalProperties": false
        },
        "confirmation": {
          "type": "object",
          "properties": {
            "toField": {
              "type": "string"
            },
            "subject": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Placeholders #=[fieldName]=# (legacy syntax); values are stripped of line breaks."
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "description": "Placeholders #=[fieldName]=#; values are HTML-escaped when format is html."
            },
            "format": {
              "enum": [
                "text",
                "html"
              ],
              "default": "text"
            }
          },
          "required": [
            "toField",
            "subject",
            "body"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "from"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "organisation"
          ]
        },
        {
          "required": [
            "confirmation"
          ]
        }
      ]
    }
  },
  "required": [
    "contractVersion",
    "proposalStatus",
    "id",
    "version",
    "tenantId",
    "title",
    "unknownFields",
    "normalization",
    "fields",
    "security",
    "storage"
  ],
  "additionalProperties": false
}
