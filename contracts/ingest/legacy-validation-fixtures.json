{
  "description": "Synthetische Paritaetsfixtures legacy-validation-v1. Erwartung ableitbar aus legacy-validation-v1.md oder php-reference-required. Keine echten Daten.",
  "adapter": {
    "adapterVersion": "legacy-validation-v1",
    "fields": [
      {"name": "vorname", "type": "text", "required": true, "rule": {"minLaenge": 2, "maxLaenge": 5}},
      {"name": "zustimmung", "type": "bool", "required": false, "rule": {}},
      {"name": "stufe", "type": "auswahl", "required": false, "rule": {"optionen": ["a", "b"]}},
      {"name": "ok", "type": "text", "required": false, "rule": {"mussSein": "ja"}},
      {"name": "alter", "type": "zahl", "required": false, "rule": {}},
      {"name": "mail", "type": "email", "required": false, "rule": {}}
    ]
  },
  "cases": [
    {"id": "missing-required", "post": {}, "expected": {"fehlend": ["vorname"], "ungueltig": []}},
    {"id": "empty-string-counts-present-skips-rules", "post": {"vorname": ""}, "expected": {"fehlend": [], "ungueltig": []}},
    {"id": "min-length-in-characters", "post": {"vorname": "ä"}, "expected": {"fehlend": [], "ungueltig": ["vorname"]}},
    {"id": "two-characters-valid-despite-four-bytes", "post": {"vorname": "äö"}, "expected": {"fehlend": [], "ungueltig": []}},
    {"id": "max-length-exceeded", "post": {"vorname": "abcdef"}, "expected": {"fehlend": [], "ungueltig": ["vorname"]}},
    {"id": "array-value-fails-length-rule", "post": {"vorname": ["ab"]}, "expected": {"fehlend": [], "ungueltig": ["vorname"]}},
    {"id": "bool-list-accepts-on", "post": {"vorname": "ab", "zustimmung": "on"}, "expected": {"fehlend": [], "ungueltig": []}},
    {"id": "bool-list-rejects-yes", "post": {"vorname": "ab", "zustimmung": "yes"}, "expected": {"fehlend": [], "ungueltig": ["zustimmung"]}},
    {"id": "bool-list-rejects-uppercase", "post": {"vorname": "ab", "zustimmung": "TRUE"}, "expected": {"fehlend": [], "ungueltig": ["zustimmung"]}},
    {"id": "auswahl-strict-member", "post": {"vorname": "ab", "stufe": "a"}, "expected": {"fehlend": [], "ungueltig": []}},
    {"id": "auswahl-non-member", "post": {"vorname": "ab", "stufe": "c"}, "expected": {"fehlend": [], "ungueltig": ["stufe"]}},
    {"id": "auswahl-array-never-valid", "post": {"vorname": "ab", "stufe": ["a"]}, "expected": {"fehlend": [], "ungueltig": ["stufe"]}},
    {"id": "muss-sein-strict", "post": {"vorname": "ab", "ok": "Ja"}, "expected": {"fehlend": [], "ungueltig": ["ok"]}},
    {"id": "unknown-field-ignored", "post": {"vorname": "ab", "unbekannt": "x"}, "expected": {"fehlend": [], "ungueltig": []}},
    {"id": "numeric-edge-leading-space", "post": {"vorname": "ab", "alter": " 12"}, "expected": "php-reference-required"},
    {"id": "numeric-edge-exponent", "post": {"vorname": "ab", "alter": "1e3"}, "expected": "php-reference-required"},
    {"id": "email-edge-unicode-local", "post": {"vorname": "ab", "mail": "jörg@example.invalid"}, "expected": "php-reference-required"}
  ]
}
